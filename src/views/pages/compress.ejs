<section class="tool-page">
  <h1>Compress PDF</h1>
  <p>Reduces file size by stripping metadata and re-encoding the document structure.</p>
  <form action="/compress" method="POST" enctype="multipart/form-data" class="upload-form">
    <input type="file" name="file" id="file-input" accept="application/pdf" required>
    <button type="submit">Compress PDF</button>
  </form>

  <div id="preview-list" class="preview-area"></div>
</section>
